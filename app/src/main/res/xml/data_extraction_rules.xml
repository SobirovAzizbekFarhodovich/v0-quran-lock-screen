<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="quran_database" />
        <!-- Auth tokens must never leave the device. -->
        <exclude
            domain="sharedpref"
            path="user_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="." />
        <exclude
            domain="sharedpref"
            path="user_session.xml" />
    </device-transfer>
</data-extraction-rules>
