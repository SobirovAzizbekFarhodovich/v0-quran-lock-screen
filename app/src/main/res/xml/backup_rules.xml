<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude
        domain="database"
        path="quran_database" />
    <!-- Auth tokens must never leave the device. -->
    <exclude
        domain="sharedpref"
        path="user_session.xml" />
    <!-- Personal data stays on the device: the assistant conversation (people
         describe their worries there), the profile and photo, recitation sync
         state. Downloaded audio and Quran data are re-downloadable and would push
         the backup past its 25 MB limit. -->
    <exclude
        domain="file"
        path="tadabbur_chat_history.json" />
    <exclude
        domain="file"
        path="profile/" />
    <exclude
        domain="file"
        path="audio/" />
    <exclude
        domain="file"
        path="quran/" />
    <exclude
        domain="sharedpref"
        path="profile.xml" />
    <exclude
        domain="sharedpref"
        path="recitation_sync.xml" />
</full-backup-content>
