<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuranReminder" parent="android:Theme.Material.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="android:statusBarColor">@color/white</item>
    </style>

    <style name="Theme.QuranReminder.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.QuranReminder.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.QuranReminder.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
